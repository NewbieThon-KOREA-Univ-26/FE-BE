# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. .env 는 Git 에 올라가지 않습니다.
# 여기 키는 브라우저에 노출되지 않습니다. 비밀 키는 반드시 백엔드에만 두세요.

# 카카오디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# Kakao Developers > App > Security. Leave blank only when Client Secret is disabled.
KAKAO_CLIENT_SECRET=

KAKAO_REDIRECT_URI=http://localhost:8000/api/auth/kakao/callback
FRONTEND_URL=http://localhost:5173

# Generate a long, unpredictable value. Never commit the actual value.
SESSION_SECRET_KEY=

# Set true for HTTPS deployments.
SESSION_COOKIE_SECURE=false

# 경로 제공자: kakao 또는 odsay
ROUTE_PROVIDER=kakao

# 카카오맵 사용 설정이 필요합니다.
KAKAO_TRANSIT_PATH=/v2/routing/publictraffic
KAKAO_WALK_PATH=/v2/routing/walk

# ROUTE_PROVIDER=odsay 로 되돌릴 때만 필요합니다.
ODSAY_API_KEY=

UPSTREAM_TIMEOUT_SECONDS=10
CORS_ORIGINS=["http://localhost:5173"]
WALK_MAX_MINUTES=30
WALK_MAX_METERS=2000
UPSTREAM_TIMEOUT_SECONDS=10

# "걸을 만하다" 의 경계. 둘 중 하나라도 넘으면 대중교통을 추천합니다.
WALK_MAX_MINUTES=30
WALK_MAX_METERS=2000

# CORS 허용 출처. JSON 배열로만 파싱됩니다. 형식이 틀리면 서버가 뜨지 않습니다.
# 백엔드를 별도 프로젝트로 배포했다면 프론트 주소를 여기에 넣어야 합니다.
# vercel.json 으로 프론트와 같은 도메인에 배포하면 필요 없습니다.
CORS_ORIGINS=["http://localhost:5173"]
