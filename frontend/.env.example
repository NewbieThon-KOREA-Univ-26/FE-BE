# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. .env 는 Git 에 올라가지 않습니다.
# VITE_ 로 시작하는 값은 브라우저 번들에 그대로 들어갑니다. 비밀 키(REST 키 등)는 절대 넣지 마세요.

# 카카오디벨로퍼스 > 내 애플리케이션 > 앱 키 > JavaScript 키 (지도·장소 검색)
VITE_KAKAO_MAP_KEY=

# 백엔드 주소. 로컬은 http://localhost:8000, 배포는 Render 주소
VITE_API_BASE_URL=http://localhost:8000

# true 면 백엔드 없이 예시 응답으로 동작합니다 (화면만 볼 때)
VITE_USE_MOCK=false
