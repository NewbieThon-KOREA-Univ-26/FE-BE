# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. .env 는 Git에 올라가지 않습니다.

# 백엔드 주소. 비워 두면 개발 서버가 /api 요청을 http://localhost:8000 으로 프록시합니다.
# Vercel 등에 배포할 때는 배포된 백엔드 주소를 넣습니다. 예: https://api.example.com
VITE_API_BASE_URL=

# true 면 백엔드 없이 API 명세서의 예시 응답으로 화면을 개발할 수 있습니다.
# 백엔드와 붙일 때는 false 로 바꾸세요. 켜져 있으면 화면 상단에 "예시 데이터 모드" 표시가 나옵니다.
VITE_USE_MOCK=true

# 카카오 지도 JavaScript 키 (developers.kakao.com > 앱 설정 > 앱 > 플랫폼 키).
# 해당 키의 JavaScript SDK 도메인에 http://localhost:5173 과 배포 주소를 등록하세요.
# 키 설정 후 개발 서버를 재시작하세요. VITE_USE_MOCK=true 여도 지도·검색은 실제로 동작합니다.
# 비워 두면 장소 검색과 지도 대신 좌표 직접 입력 화면이 나옵니다.
VITE_KAKAO_MAP_KEY=
